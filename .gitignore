# Secrets — never commit. Ignore every .env* variant; the placeholder-only
# .env.example is the sole tracked exception.
.env
.env.*
!.env.example

# Terraform (deploy/terraform) — state, provider cache, and real tfvars.
# Example tfvars are tracked so the shape is documented.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json

# Go
backend/bin/
backend/tmp/

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
*.tsbuildinfo

# OS / editor
.DS_Store
*.log
