# Secrets — never commit. Ignore every .env* variant; the placeholder-only
# .env.example is the sole tracked exception.
.env
.env.*
!.env.example

# Terraform (deploy/terraform) — state, provider cache, and real tfvars.
# Example tfvars are tracked so the shape is documented.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json

# Go
backend/bin/
backend/tmp/
# Stray `go build` output: the binary defaults to the package-dir name, so
# `go build ./cmd/proxcloud` from backend/ drops an executable here.
backend/proxcloud
backend/cmd/proxcloud/proxcloud

# Node / Next.js
node_modules/
frontend/.next/
frontend/out/
frontend/coverage/
*.tsbuildinfo

# OS / editor
.DS_Store
*.log
.claude/

# Prod edge: the live-color symlink is state on the guest (bootstrap.sh
# points it at state/live-color) and must never be provisioned over it.
deploy/host/prod/caddy/upstream/active.caddy
