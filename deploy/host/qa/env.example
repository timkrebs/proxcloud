# ─────────────────────────────────────────────────────────────────────────────
# Proxcloud QA env — copy to /opt/proxcloud/.env on the qa guest.
# CREATED MANUALLY, PER GUEST. Never enters git or CI (release-engineer.md).
# ─────────────────────────────────────────────────────────────────────────────

# ── Image source (NON-secret). deploy.sh sets IMAGE_REF per deploy. ──
REGISTRY=ghcr.io/timkrebs
GHCR_USER=timkrebs
GHCR_TOKEN=CHANGEME_ghcr_read_packages_pat   # only if packages are private

# ── Proxmox (qa may point at the SAME pve01 with a scoped token) ──
PROXMOX_URL=https://pve01.proxcloud.lab:8006
PROXMOX_TOKEN_ID=proxcloud-qa@pve!cd
PROXMOX_TOKEN_SECRET=CHANGEME
PROXMOX_TLS_INSECURE=true
PROXMOX_CONSOLE_USER=
PROXMOX_CONSOLE_PASSWORD=

# ── Postgres (in-stack). Password here MUST match the one in DATABASE_URL. ──
POSTGRES_USER=proxcloud
POSTGRES_PASSWORD=CHANGEME_qa_db_password
POSTGRES_DB=proxcloud
DATABASE_URL=postgres://proxcloud:CHANGEME_qa_db_password@proxcloud-qa-postgres:5432/proxcloud?sslmode=require

# ── App runtime ──
PROXCLOUD_ENV=production
SECRETS_KEY=CHANGEME_openssl_rand_hex_32
FRONTEND_ORIGIN=https://qa.proxcloud.lab
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=720h
RECONCILER_INTERVAL=5m
RESERVATION_TTL=45m
INVITATION_TTL=72h
LOGIN_CHALLENGE_TTL=5m
TOTP_ISSUER=Proxcloud

# ── Email — qa usually uses the dev log-mailer (leave SMTP_HOST blank) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=proxcloud@qa.proxcloud.lab
SMTP_STARTTLS=true

# ── Smoke fixture (ADR-0016 §4). deploy.sh runs `proxcloud seed-smoke` under
#    SMOKE_SEED before the smoke gate. These MUST equal the smoke job's
#    QA_SMOKE_EMAIL/QA_SMOKE_PASSWORD secrets so the seeded user matches the
#    login. QA uses its OWN smoke creds, distinct from staging/prod. ──
SMOKE_SEED=1
SMOKE_EMAIL=smoke@qa.proxcloud.lab
SMOKE_PASSWORD=CHANGEME_qa_smoke_password

# ── Deploy notifications + tunables (NON-secret) ──
NTFY_URL=
MIGRATE_TIMEOUT=300
HEALTH_TIMEOUT=120
USE_MIGRATOR_SERVICE=0   # set 1 once the backend ships a `migrate` subcommand
