# Proxcloud QA edge (ADR-0015). Single upstream (no blue/green). Same
# SSE/WS passthrough as prod: /api/* -> backend with buffering off and HTTP/1.1
# pinned; everything else -> frontend.
#
# DEFAULT: Caddy internal CA on qa.proxcloud.lab (LAN). Alternatives are
# documented below; pick one and keep FRONTEND_ORIGIN in .env in sync.

{
	admin localhost:2019
}

qa.proxcloud.lab {
	tls internal

	@api path /api/*
	handle @api {
		reverse_proxy proxcloud-qa-backend:8080 {
			flush_interval -1
			# ADR-0034: ALWAYS overwrite X-Real-IP with the resolved client IP.
			# QA fronts clients DIRECTLY (no tunnel), so {client_ip} is the TCP
			# peer — still the correct value, and the overwrite guarantees a
			# client-supplied X-Real-IP can never reach the backend (which
			# prefers this header from its trusted proxy).
			header_up X-Real-IP {client_ip}
			transport http {
				versions 1.1
			}
		}
	}
	handle {
		reverse_proxy proxcloud-qa-frontend:3000
	}
}

# ── Alt: plain HTTP behind cloudflared (TLS at Cloudflare) ──
# :80 {
# 	@api path /api/*
# 	handle @api { reverse_proxy proxcloud-qa-backend:8080 { flush_interval -1
# 		transport http { versions 1.1 } } }
# 	handle { reverse_proxy proxcloud-qa-frontend:3000 }
# }

# ── Alt: public domain, Caddy ACME ──
# qa.proxcloud.example.com { ... same handle blocks ... }
