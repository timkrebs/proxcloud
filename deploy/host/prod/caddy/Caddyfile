# Proxcloud PROD edge (ADR-0015 §3). The whole switch is: `active.caddy` is a
# symlink -> blue.caddy | green.caddy, flipped atomically by deploy.sh, then
# `caddy reload` (graceful, zero-drop; in-flight SSE/WS on the old color drain).
#
# ── TLS MODE — pick exactly ONE site block below (ADR-0015 §6) ───────────────
# pve01 sits behind a Cloudflare Tunnel, so Mode A (plain HTTP, TLS terminated
# at Cloudflare) is the likely prod path and is the DEFAULT here. To use a LAN
# internal CA or a public ACME cert instead, comment Mode A and uncomment B/C
# and set FRONTEND_ORIGIN in .env to match the scheme+host.
#
# NOTE: upstream/*.caddy force `header_up X-Forwarded-Proto https` so the backend
# marks the session cookie Secure. All three modes serve the site over HTTPS
# externally, so this constant is correct for A/B/C alike. Only change it (to
# `{http.request.scheme}`) if you deliberately serve the public site over plain
# HTTP — an unsupported, insecure configuration.

{
	admin localhost:2019
	# email you@example.com          # required for Mode C (ACME) only

	# ── Client-IP trust chain (ADR-0034) ────────────────────────────────────
	# cloudflared runs as a service on this host and connects to the published
	# 127.0.0.1:80. Docker relays that connection into this container from the
	# proxcloud-edge GATEWAY, so every tunneled request arrives from
	# 10.254.254.1 (pinned by bin/ensure-networks.sh) — never from loopback.
	# Caddy derives the real client IP from Cloudflare's CF-Connecting-IP for
	# that source only; since the port is bound to loopback, only processes on
	# this host can connect from it. {client_ip} is what upstream/*.caddy
	# writes into X-Real-IP, and the backend reads X-Real-IP only from Caddy's
	# own pinned address (TRUSTED_PROXY_CIDRS=10.254.254.10/32).
	# If trusted_proxies and the real source ever disagree, {client_ip} falls
	# back to the TCP peer — every user then shares one bucket, but nothing
	# becomes spoofable.
	# (A containerized cloudflared would instead need its own pinned address on
	# proxcloud-edge, trusted here as a /32.)
	servers {
		trusted_proxies static 10.254.254.1/32
		client_ip_headers CF-Connecting-IP
	}
}

# ── Mode A (DEFAULT): plain HTTP behind cloudflared; Cloudflare terminates TLS ─
# The compose file publishes this listener on 127.0.0.1 only (tunnel-only).
:80 {
	import /etc/caddy/upstream/active.caddy
}

