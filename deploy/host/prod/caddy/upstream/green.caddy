# Routing to the GREEN color (ADR-0015 §3/§5). Imported into the prod site block
# when active.caddy -> green.caddy. See blue.caddy for the SSE/WS rationale.
@api path /api/*
handle @api {
	reverse_proxy proxcloud-green-backend:8080 {
		flush_interval -1                 # SSE: flush events immediately, no buffering
		# Mode A (ADR-0015 §6): external TLS at Cloudflare, plain-HTTP hop here.
		# header_up SETS (overwrites) X-Forwarded-Proto so a client cannot spoof
		# it; the backend keys the session cookie's Secure attribute off this.
		header_up X-Forwarded-Proto https
		# ADR-0034: ALWAYS overwrite X-Real-IP with Caddy's resolved client IP
		# (see blue.caddy for the full rationale) — the backend's preference for
		# X-Real-IP is safe only because this hop overwrites it.
		header_up X-Real-IP {client_ip}
		transport http {
			versions 1.1                  # WS: keep the hop on HTTP/1.1 for Upgrade
		}
	}
}
handle {
	reverse_proxy proxcloud-green-frontend:3000
}
