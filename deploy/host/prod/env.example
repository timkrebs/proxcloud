# ─────────────────────────────────────────────────────────────────────────────
# Proxcloud PROD env — copy to /opt/proxcloud/.env on the prod guest.
# (Named env.example here to stay out of any .env* ignore/secret tooling.)
#
# CREATED MANUALLY, PER GUEST. The real /opt/proxcloud/.env NEVER enters git or
# CI. The delivery pipeline templates only NON-secret config and only ever
# invokes deploy.sh over SSH — it never sees these values (ADR-0014 §7,
# release-engineer.md). After filling every CHANGEME:
#   cp env.example /opt/proxcloud/.env   # then edit
#   sudo /opt/proxcloud/bootstrap.sh
#   /opt/proxcloud/bin/up-infra.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── Image source (NON-secret). deploy.sh sets IMAGE_REF itself per deploy. ──
REGISTRY=ghcr.io/timkrebs
# GHCR pull auth — needed ONLY if the packages are PRIVATE. Use a read:packages
# scoped PAT (NOT your account password). Leave blank for public packages.
GHCR_USER=timkrebs
GHCR_TOKEN=CHANGEME_ghcr_read_packages_pat

# ── Proxmox (the backend is the sole component that talks to PVE) ──
PROXMOX_URL=https://pve01.proxcloud.lab:8006
PROXMOX_TOKEN_ID=proxcloud@pve!cd
PROXMOX_TOKEN_SECRET=CHANGEME
PROXMOX_TLS_INSECURE=true
# Optional console (noVNC/xterm) — PVE vncwebsocket rejects API tokens, so a
# ticket login is needed. Leave both blank to disable console features.
PROXMOX_CONSOLE_USER=
PROXMOX_CONSOLE_PASSWORD=

# ── Postgres (shared proxcloud-data project) ──
# POSTGRES_PASSWORD and the password inside DATABASE_URL MUST match.
POSTGRES_USER=proxcloud
POSTGRES_PASSWORD=CHANGEME_strong_db_password
POSTGRES_DB=proxcloud
DATABASE_URL=postgres://proxcloud:CHANGEME_strong_db_password@proxcloud-data-postgres:5432/proxcloud?sslmode=require

# ── App runtime ──
PROXCLOUD_ENV=production
# 32 bytes; generate with: openssl rand -hex 32
SECRETS_KEY=CHANGEME_openssl_rand_hex_32
# The public origin users hit — MUST match the chosen Caddy TLS mode
# (Mode A/cloudflared -> https://<public-host>; Mode B -> https://proxcloud.lab).
FRONTEND_ORIGIN=https://proxcloud.lab
# Trusted reverse-proxy CIDRs whose X-Forwarded-* the backend honors (real
# client IP for rate limiting/audit; scheme for the Secure cookie). Set this to
# the Caddy/docker-edge network CIDR so per-IP limits key off the REAL client;
# from any other peer the forwarded headers are stripped (anti-spoof). Find it
# with: docker network inspect proxcloud-edge -f '{{(index .IPAM.Config 0).Subnet}}'
# Default (unset) trusts only loopback — safe but makes all traffic look like the
# proxy for rate-limiting. The per-account login lockout is IP-independent.
TRUSTED_PROXY_CIDRS=172.18.0.0/16
# Host-header allowlist (ADR-0017): comma-separated hosts the backend serves;
# any other Host is rejected 421 (DNS-rebinding defense). Set to the public
# portal host(s) + the internal compose backend service name. Empty = disabled.
ALLOWED_HOSTS=portal.proxcloud.io,proxcloud-blue-backend,proxcloud-green-backend,localhost
SESSION_IDLE_TTL=12h
SESSION_ABSOLUTE_TTL=720h
RECONCILER_INTERVAL=5m
RESERVATION_TTL=45m
INVITATION_TTL=72h
LOGIN_CHALLENGE_TTL=5m
TOTP_ISSUER=Proxcloud

# ── Outbound email (Phase 5 invitations). Leave SMTP_HOST blank to use the dev
#    log-mailer. If SMTP_HOST is set, SMTP_FROM is required. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=proxcloud@proxcloud.lab
SMTP_STARTTLS=true

# ── Deploy notifications (NON-secret topic URL; deploy.sh posts a summary) ──
NTFY_URL=

# ── Smoke fixture (ADR-0016 §4). Prod defaults SMOKE_SEED=0 (no test tenant in a
#    real user-facing env). Set SMOKE_SEED=1 ONLY if you want prod smoke; then
#    SMOKE_EMAIL/SMOKE_PASSWORD MUST equal the production-environment smoke
#    secrets AND be SEPARATE from staging's (a staging cred must never act on
#    prod). deploy.sh runs `proxcloud seed-smoke` under this flag before cutover. ──
SMOKE_SEED=0
SMOKE_EMAIL=
SMOKE_PASSWORD=

# ── Deploy tunables (NON-secret; read by deploy.sh) ──
SNAPSHOT_RETAIN=14
MIGRATE_TIMEOUT=300
HEALTH_TIMEOUT=120
# Set to 1 ONLY once the backend ships a `migrate` subcommand (coordinate item).
USE_MIGRATOR_SERVICE=0
# Soak/cleanup sweep (soak.yml -> `soak` wrapper verb -> soak.sh). Retire the
# old color only after this many hours; keep this many images per repo.
SOAK_HOURS=24
SOAK_KEEP_IMAGES=10
