# shellcheck shell=bash
# Proxcloud installer — core library (ADR-0031 §1, ADR-0032 §6).
#
# Sourced by install/install.sh (never executed). Provides logging with UTC
# timestamps tee'd to the install log, the redaction-aware run() wrapper,
# secret generation, the strict %%VAR%% template renderer, and prompt helpers
# that honor PC_* pre-seeds and PC_YES=1.
#
# Iron rule (structural, not conventional): secrets exist ONLY in shell
# variables and rendered 0600 files. They are never passed on argv, never
# handed to log()/run() as arguments, and everything that IS logged passes
# a redaction filter that replaces every known secret value with ***.

PC_LOG_FILE="${PC_LOG_FILE:-/var/log/proxcloud-install.log}"
PC_LOG_READY="${PC_LOG_READY:-0}"

# Values to scrub from anything we write to the log or the console.
declare -a PC_REDACT_VALUES=()
# Variable names that passed intake validation — the ONLY names render() will
# substitute (ADR-0031 §6: interpolation is never the first line of defence).
# A space-delimited " NAME " list (not an assoc array) so the libs stay
# sourceable on old bash for the dev-machine dry test.
PC_VALIDATED_NAMES=" "

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# core_log_init — create/append the install log (root path); called once by the
# orchestrator AFTER the root check so sourcing this file has no side effects.
core_log_init() {
  if touch "$PC_LOG_FILE" 2>/dev/null; then
    chmod 0600 "$PC_LOG_FILE"
    PC_LOG_READY=1
  else
    printf '%s [installer][WARN] cannot write %s — continuing without a log file\n' \
      "$(now)" "$PC_LOG_FILE" >&2
  fi
}

# redact_register <value> — add a secret value to the scrub list.
redact_register() {
  [ -n "${1:-}" ] || return 0
  PC_REDACT_VALUES+=("$1")
}

# _redact_collect_vars — sweep ALL shell variables whose NAME matches the
# secret patterns (*SECRET* / *PASSWORD* / *PW*) into the scrub list, so a
# secret can never be logged merely because someone forgot to register it.
_redact_collect_vars() {
  local n v
  while IFS= read -r n; do
    case "$n" in
      PWD|OLDPWD) continue ;;  # shell cwd vars — paths, not secrets
    esac
    case "$n" in
      *SECRET*|*PASSWORD*|*PW*)
        v="${!n:-}"
        [ -n "$v" ] && PC_REDACT_VALUES+=("$v")
        ;;
    esac
  done < <(compgen -A variable)
}

# redact_line <text> — print <text> with every known secret replaced by ***.
redact_line() {
  local s="${1-}" v
  _redact_collect_vars
  for v in ${PC_REDACT_VALUES[@]+"${PC_REDACT_VALUES[@]}"}; do
    [ -n "$v" ] && s="${s//"$v"/***}"
  done
  printf '%s' "$s"
}

# _log_sink <line> — append a (pre-redacted) line to the install log.
_log_sink() {
  [ "$PC_LOG_READY" = "1" ] || return 0
  printf '%s\n' "$1" >> "$PC_LOG_FILE"
}

log() {
  local line
  line="$(now) [installer] $(redact_line "$*")"
  printf '%s\n' "$line"
  _log_sink "$line"
}

warn() {
  local line
  line="$(now) [installer][WARN] $(redact_line "$*")"
  printf '%s\n' "$line" >&2
  _log_sink "$line"
}

die() {
  local line
  line="$(now) [installer][FATAL] $(redact_line "$*")"
  printf '%s\n' "$line" >&2
  _log_sink "$line"
  exit 1
}

# run <argv...> — execute an argv array (NEVER a shell string), logging the
# redacted argv first. Output is captured, redacted, and appended to the log;
# on failure the last 20 lines are shown and the step dies with a message
# naming the command. Secrets must never appear in the argv handed to run()
# (stdin pipes only) — redaction here is defence in depth, not permission.
run() {
  local out rc=0
  log "run: $*"
  out="$("$@" 2>&1)" || rc=$?
  if [ -n "$out" ]; then
    _log_sink "$(redact_line "$out")"
  fi
  if [ "$rc" -ne 0 ]; then
    printf '%s\n' "$(redact_line "$out")" | tail -n 20 >&2
    die "command failed (exit $rc): $1 ${2:-} — full output in $PC_LOG_FILE"
  fi
  return 0
}

# secret_gen <alnum|hex> <len> — generate a secret with openssl rand (never
# $RANDOM/timestamps, ADR-0032 §6) and register it for redaction.
secret_gen() {
  local kind="${1:?secret_gen: kind (alnum|hex) required}"
  local len="${2:?secret_gen: length required}"
  local s
  case "$kind" in
    hex)
      s="$(openssl rand -hex "$((len / 2))")" ;;
    alnum)
      s="$(openssl rand -base64 $((len * 2)) | tr -dc 'A-Za-z0-9' | head -c "$len")"
      [ "${#s}" -eq "$len" ] || { printf 'secret_gen: short output\n' >&2; return 1; } ;;
    *)
      printf 'secret_gen: unknown kind %s\n' "$kind" >&2; return 1 ;;
  esac
  redact_register "$s"
  printf '%s' "$s"
}

# mark_validated <NAME...> — record that NAME's value passed intake validation
# (or was generated by the installer itself) and may be rendered.
mark_validated() {
  local n
  for n in "$@"; do
    case "$PC_VALIDATED_NAMES" in
      *" $n "*) ;;
      *) PC_VALIDATED_NAMES="${PC_VALIDATED_NAMES}${n} " ;;
    esac
  done
}

# is_validated <NAME> — true when NAME was marked validated.
is_validated() {
  case "$PC_VALIDATED_NAMES" in
    *" $1 "*) return 0 ;;
    *) return 1 ;;
  esac
}

# validate <NAME> <regex> <what> — die unless ${!NAME} matches; marks validated.
validate() {
  local name="${1:?}" re="${2:?}" what="${3:?}" val
  val="${!name:-}"
  if ! printf '%s' "$val" | grep -Eq "$re"; then
    die "invalid $what: '$(redact_line "$val")' (must match $re)"
  fi
  mark_validated "$name"
}

# render <template> <dest> — substitute every %%VAR%% in <template>. Dies if a
# referenced variable is unset OR has not been marked validated: a value that
# reaches render() must already be proven safe (ADR-0031 §6). Substitution is
# literal bash string replacement — no shell/sed re-interpretation of values.
render() {
  local tpl="${1:?render: template required}" dest="${2:?render: dest required}"
  [ -f "$tpl" ] || die "render: template not found: $tpl"
  local content name
  content="$(cat "$tpl")"
  while IFS= read -r name; do
    [ -n "$name" ] || continue
    if [ -z "${!name+x}" ]; then
      die "render: %%${name}%% referenced by $tpl but \$${name} is unset"
    fi
    if ! is_validated "$name"; then
      die "render: %%${name}%% referenced by $tpl but \$${name} never passed a validator"
    fi
    content="${content//"%%${name}%%"/${!name}}"
  done < <(grep -oE '%%[A-Z0-9_]+%%' "$tpl" | tr -d '%' | sort -u)
  if printf '%s' "$content" | grep -qE '%%[A-Z0-9_]+%%'; then
    die "render: unresolved placeholders remain in $tpl"
  fi
  printf '%s\n' "$content" > "$dest"
}

# _tty_read <prompt> — read a line from the controlling tty (curl|bash leaves
# stdin consumed); falls back to stdin when no tty exists.
_tty_read() {
  local prompt="$1" reply
  if [ -r /dev/tty ] && [ -w /dev/tty ]; then
    read -r -p "$prompt" reply < /dev/tty > /dev/tty 2>&1 || true
  else
    read -r -p "$prompt" reply || true
  fi
  printf '%s' "$reply"
}

# ask <VAR> <prompt> <default> — resolve VAR: pre-seeded PC_* value wins, then
# PC_YES=1 takes the default, then the user is prompted (empty -> default).
ask() {
  local var="${1:?}" prompt="${2:?}" def="${3-}" val
  val="${!var:-}"
  if [ -n "$val" ]; then
    log "$prompt -> $val (pre-seeded \$$var)"
    return 0
  fi
  if [ "${PC_YES:-0}" = "1" ]; then
    [ -n "$def" ] || die "PC_YES=1 but '$prompt' has no default — set \$$var"
    printf -v "$var" '%s' "$def"
    log "$prompt -> $def (PC_YES default)"
    return 0
  fi
  val="$(_tty_read "$prompt${def:+ [$def]}: ")"
  [ -n "$val" ] || val="$def"
  [ -n "$val" ] || die "'$prompt' requires a value"
  printf -v "$var" '%s' "$val"
}

# ask_yesno <VAR> <prompt> <y|n default> — sets VAR to y or n.
ask_yesno() {
  local var="${1:?}" prompt="${2:?}" def="${3:-y}" val
  val="${!var:-}"
  if [ -z "$val" ]; then
    if [ "${PC_YES:-0}" = "1" ]; then
      val="$def"
    else
      val="$(_tty_read "$prompt [y/n, default $def]: ")"
      [ -n "$val" ] || val="$def"
    fi
  fi
  case "$val" in
    y|Y|yes|YES) printf -v "$var" 'y' ;;
    n|N|no|NO)   printf -v "$var" 'n' ;;
    *) die "'$prompt': answer y or n (got '$val')" ;;
  esac
}

# menu <VAR> <prompt> <option...> — numbered pick list. A pre-seeded $VAR must
# be a member of the option list; PC_YES=1 takes the first option.
menu() {
  local var="${1:?}" prompt="${2:?}"; shift 2
  local -a opts=("$@")
  [ "${#opts[@]}" -gt 0 ] || die "menu '$prompt': no options available"
  local val="${!var:-}" i pick
  if [ -n "$val" ]; then
    for i in "${opts[@]}"; do
      if [ "$i" = "$val" ]; then log "$prompt -> $val (pre-seeded \$$var)"; return 0; fi
    done
    die "\$$var='$val' is not one of: ${opts[*]}"
  fi
  if [ "${PC_YES:-0}" = "1" ]; then
    printf -v "$var" '%s' "${opts[0]}"
    log "$prompt -> ${opts[0]} (PC_YES default)"
    return 0
  fi
  printf '%s\n' "$prompt" > /dev/tty 2>/dev/null || printf '%s\n' "$prompt"
  for i in "${!opts[@]}"; do
    printf '  %2d) %s\n' "$((i + 1))" "${opts[$i]}" > /dev/tty 2>/dev/null \
      || printf '  %2d) %s\n' "$((i + 1))" "${opts[$i]}"
  done
  pick="$(_tty_read "Select [1-${#opts[@]}, default 1]: ")"
  [ -n "$pick" ] || pick=1
  case "$pick" in (*[!0-9]*|'') die "'$prompt': not a number: $pick" ;; esac
  { [ "$pick" -ge 1 ] && [ "$pick" -le "${#opts[@]}" ]; } || die "'$prompt': out of range: $pick"
  printf -v "$var" '%s' "${opts[$((pick - 1))]}"
}
