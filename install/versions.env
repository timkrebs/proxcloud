# Proxcloud installer version lock (ADR-0033 §3).
# The values below are DEV PLACEHOLDERS. The release workflow
# (installer-release.yml) rewrites this file inside the payload tarball from
# the release tag, so a downloaded installer and the images it pulls are the
# same version by construction. Images are pulled by exact semver — never
# `latest`, never a raw SHA.
INSTALLER_VERSION=dev
APP_SEMVER=dev
IMAGE_BACKEND=ghcr.io/timkrebs/proxcloud-backend
IMAGE_FRONTEND=ghcr.io/timkrebs/proxcloud-frontend
