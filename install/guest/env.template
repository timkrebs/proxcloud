# Proxcloud appliance configuration — RENDERED BY THE INSTALLER (ADR-0031 §7).
# The percent-percent placeholders below are substituted by render() (values
# must have passed a validator) and the result lands as /opt/proxcloud/.env,
# mode 0600, in the guest. This file contains NO real values.
#
# SECRETS LIVE HERE AND ONLY HERE. Never commit, copy, or paste this file.

# ── Proxmox connection (backend → PVE API) ───────────────────────────────────
# The PVE host's IP on the bridge the guest is attached to, port 8006.
PROXMOX_URL=%%PROXMOX_URL%%
# Installer-created least-privilege token (role Proxcloud, privsep on;
# scope + deny-list per ADR-0032 — see the install summary).
PROXMOX_TOKEN_ID=%%PROXMOX_TOKEN_ID%%
PROXMOX_TOKEN_SECRET=%%PROXMOX_TOKEN_SECRET%%
# Applies to the backend → PVE hop ONLY: PVE ships a self-signed certificate
# by default, so verification is skipped on that single internal hop. Portal
# traffic is unaffected. A verified-TLS option arrives with Advanced mode.
PROXMOX_TLS_INSECURE=true

# ── Console credentials (websockets reject token auth — ADR-0003/0032 §4) ───
# Same proxcloud@pve identity, bounded by the same role. Both empty when the
# installer's console login check failed (Console blade shows disabled state).
PROXMOX_CONSOLE_USER=%%PROXMOX_CONSOLE_USER%%
PROXMOX_CONSOLE_PASSWORD=%%PROXMOX_CONSOLE_PASSWORD%%

# ── Database ─────────────────────────────────────────────────────────────────
# In-stack Postgres. sslmode=require: the link is ENCRYPTED against the
# installer-generated self-signed cert (no CA verification needed) — the
# backend fails closed in production without TLS here.
POSTGRES_USER=proxcloud
POSTGRES_PASSWORD=%%POSTGRES_PASSWORD%%
POSTGRES_DB=proxcloud
DATABASE_URL=postgres://proxcloud:%%POSTGRES_PASSWORD%%@postgres:5432/proxcloud?sslmode=require

# ── Secrets-at-rest key (32 bytes hex; generated with openssl rand -hex 32) ──
SECRETS_KEY=%%SECRETS_KEY%%

# ── First-run platform admin (seeded ONLY while the users table is empty) ────
# Sign-in email is admin@proxcloud.local (a bare user is normalised by
# appending the domain). Change the password after first login, then these
# values are inert.
ADMIN_USER=%%ADMIN_USER%%
ADMIN_PASSWORD=%%ADMIN_PASSWORD%%

# ── Origin enforcement ───────────────────────────────────────────────────────
# MUST be byte-identical to the portal URL you browse (scheme://host, exact
# match). The installer derives this and the printed URL from the same value.
# A DHCP lease change breaks this until reconfigured.
FRONTEND_ORIGIN=%%FRONTEND_ORIGIN%%

# PROXCLOUD_ENV / LISTEN_ADDR are set by docker-compose.yml (production, :8080).
# PROXCLOUD_INSECURE_COOKIES is never set: Caddy forwards the real scheme and
# the backend trusts it (TRUST_PROXY_HEADERS defaults on in production).
