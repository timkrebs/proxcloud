#cloud-config
# MongoDB first-boot user-data, rendered server-side by
# internal/catalog/render.go and delivered as a snippet referenced by
# `cicustom "user=<datastore>:snippets/<file>.yaml"` (ADR-0025).
#
# OVERRIDE CONTRACT (docs/proxmox/cloud-init.md §1.4, ADR-0025): when
# `cicustom user=` is set, PVE DROPS the inline ciuser/cipassword/sshkeys — the
# custom user-data is authoritative — so this file MUST carry the login
# identity itself (users:/ssh_authorized_keys:). params.go never emits those
# three inline params for a catalog guest.
#
# CREDENTIAL SAFETY (docs/proxmox/cloud-init.md §4, ADR-0027 §1, SECURITY-
# CRITICAL): neither the raw root password NOR the operator's SSH public keys
# ever appear in this YAML or in a shell string. Only their render-time base64
# blobs are interpolated (base64 alphabet has no YAML/shell metacharacters);
# they are decoded IN-GUEST at first boot. The password is handed to mongosh via
# the process environment (process.env), never spliced into the JS text or argv.
hostname: {{ .Hostname }}
manage_etc_hosts: true

# NOTE: ssh_authorized_keys is deliberately NOT set here — keys are installed via
# base64-decode in runcmd below so a hostile key cannot break this YAML.
users:
  - name: {{ .LoginUser }}
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true

package_update: true
packages:
  # qemu-guest-agent is REQUIRED: it is what makes the deploy engine's
  # `configuring` step observe the guest's IP (ADR-0028, docs §3). curl + gnupg
  # are needed to add MongoDB's apt repo (mongodb-org is not in Ubuntu's repos).
  - qemu-guest-agent
  - curl
  - gnupg

runcmd:
  - [ systemctl, enable, --now, qemu-guest-agent ]
  # Install the operator's SSH public key(s) for the login user. Each key is
  # base64-encoded at render time (docs/proxmox/cloud-init.md §4) so a hostile key
  # string can never inject YAML structure or a shell command; it is decoded
  # in-guest and appended to authorized_keys, one key per line.
  - |
    set -eu
    SSH_DIR="/home/{{ .LoginUser }}/.ssh"
    AK="$SSH_DIR/authorized_keys"
    install -d -m 700 "$SSH_DIR"
    : > "$AK"
    {{- range .SSHKeysB64 }}
    printf %s '{{ . }}' | base64 -d >> "$AK"
    printf '\n' >> "$AK"
    {{- end }}
    chmod 600 "$AK"
    chown -R "{{ .LoginUser }}:{{ .LoginUser }}" "$SSH_DIR"
  # Add the MongoDB 8.0 apt repository and install the server + mongosh.
  - |
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    curl -fsSL https://www.mongodb.org/static/pgp/server-8.0.asc \
      | gpg --dearmor -o /usr/share/keyrings/mongodb-server-8.0.gpg
    echo "deb [ arch=amd64,arm64 signed-by=/usr/share/keyrings/mongodb-server-8.0.gpg ] https://repo.mongodb.org/apt/ubuntu noble/mongodb-org/8.0 multiverse" \
      > /etc/apt/sources.list.d/mongodb-org-8.0.list
    apt-get update
    apt-get install -y mongodb-org
    systemctl enable --now mongod
  # Create the administrative root user, THEN enable authorization and open the
  # bind address. The password is decoded in-guest into an EXPORTED env var and
  # read by mongosh via process.env inside a QUOTED heredoc — the shell performs
  # no expansion, so the raw bytes never touch the JS text, YAML, or argv.
  - |
    set -eu
    export MONGO_USER="$(printf %s '{{ .SuperuserUserB64 }}' | base64 -d)"
    export MONGO_PASS="$(printf %s '{{ .SuperuserPassB64 }}' | base64 -d)"

    # Wait for mongod (localhost, no auth yet) to accept connections.
    for _ in $(seq 1 60); do
      if mongosh --quiet --eval 'db.runCommand({ ping: 1 })' >/dev/null 2>&1; then
        break
      fi
      sleep 2
    done

    # Create the root user via the localhost exception (auth still off). The
    # credential is read from process.env, never interpolated into this JS.
    mongosh --quiet admin <<'EOF'
    db.getSiblingDB("admin").createUser({
      user: process.env.MONGO_USER,
      pwd: process.env.MONGO_PASS,
      roles: [ { role: "root", db: "admin" } ]
    });
    EOF
    unset MONGO_PASS MONGO_USER

    # Enable authentication and listen on all interfaces so the service is
    # reachable over TCP. A homelab MongoDB is reached remotely; restrict this
    # with the guest firewall / your LAN before putting real data on it (see the
    # service's next-steps and ports).  # SECURITY-REVIEW: network exposure.
    sed -i 's/^\( *\)bindIp:.*/\1bindIpAll: true/' /etc/mongod.conf
    if ! grep -q '^security:' /etc/mongod.conf; then
      printf '\nsecurity:\n  authorization: enabled\n' >> /etc/mongod.conf
    fi
    systemctl restart mongod
