#cloud-config
# Vault CE first-boot user-data, rendered server-side by
# internal/catalog/render.go and delivered as a snippet referenced by
# `cicustom "user=<datastore>:snippets/<file>.yaml"` (ADR-0025).
#
# OVERRIDE CONTRACT (docs/proxmox/cloud-init.md §1.4, ADR-0025): when
# `cicustom user=` is set, PVE DROPS the inline ciuser/cipassword/sshkeys — the
# custom user-data is authoritative — so this file MUST carry the login
# identity itself (users:/ssh_authorized_keys:). params.go never emits those
# three inline params for a catalog guest.
#
# VAULT HONESTY (ADR-0027 §4): this template installs Vault in SERVER mode,
# started SEALED and UNINITIALIZED. It deliberately does NOT run `vault operator
# init` and never handles unseal keys or the root token — those are generated by,
# and only ever seen by, the operator. There is NO injected credential here (the
# service's credential schema is empty), so no base64 password blob is
# interpolated; the only untrusted values in this file are the operator's SSH
# keys, which go through the standard base64 pipeline (docs §4).
#
# WARNING — TLS IS DISABLED: the listener below is plain HTTP (tls_disable = 1).
# This is a homelab default so the operator can reach the API without minting a
# cert first. DO NOT expose port 8200 publicly until you enable TLS.
hostname: {{ .Hostname }}
manage_etc_hosts: true

# NOTE: ssh_authorized_keys is deliberately NOT set here — keys are installed via
# base64-decode in runcmd below so a hostile key cannot break this YAML.
users:
  - name: {{ .LoginUser }}
    groups: [sudo]
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true

package_update: true
packages:
  # qemu-guest-agent is REQUIRED: it is what makes the deploy engine's
  # `configuring` step observe the guest's IP (ADR-0028, docs §3). curl + gnupg
  # are needed to add HashiCorp's apt repo.
  - qemu-guest-agent
  - curl
  - gnupg

runcmd:
  - [ systemctl, enable, --now, qemu-guest-agent ]
  # Install the operator's SSH public key(s) for the login user. Each key is
  # base64-encoded at render time (docs/proxmox/cloud-init.md §4) so a hostile key
  # string can never inject YAML structure or a shell command; it is decoded
  # in-guest and appended to authorized_keys, one key per line.
  - |
    set -eu
    SSH_DIR="/home/{{ .LoginUser }}/.ssh"
    AK="$SSH_DIR/authorized_keys"
    install -d -m 700 "$SSH_DIR"
    : > "$AK"
    {{- range .SSHKeysB64 }}
    printf %s '{{ . }}' | base64 -d >> "$AK"
    printf '\n' >> "$AK"
    {{- end }}
    chmod 600 "$AK"
    chown -R "{{ .LoginUser }}:{{ .LoginUser }}" "$SSH_DIR"
  # Add HashiCorp's apt repository and install Vault CE.
  - |
    set -eu
    export DEBIAN_FRONTEND=noninteractive
    curl -fsSL https://apt.releases.hashicorp.com/gpg \
      | gpg --dearmor -o /usr/share/keyrings/hashicorp-archive-keyring.gpg
    echo "deb [signed-by=/usr/share/keyrings/hashicorp-archive-keyring.gpg] https://apt.releases.hashicorp.com noble main" \
      > /etc/apt/sources.list.d/hashicorp.list
    apt-get update
    apt-get install -y vault
  # Write a minimal server config: file storage, a plain-HTTP listener with TLS
  # DISABLED (see the loud warning above), and the UI enabled. We do NOT
  # initialise or unseal — Vault comes up SEALED and UNINITIALIZED, and the
  # operator finishes setup themselves (ADR-0027 §4; see next-steps). The config
  # is static (only the port is interpolated) and carries NO secret.
  - |
    set -eu
    install -d -m 700 -o vault -g vault /opt/vault/data
    cat > /etc/vault.d/vault.hcl <<'EOF'
    # WARNING: TLS IS DISABLED (tls_disable = 1) — this listener is plain HTTP.
    # Do NOT expose this port publicly. Enable TLS before any real use.
    ui = true

    storage "file" {
      path = "/opt/vault/data"
    }

    listener "tcp" {
      address     = "0.0.0.0:{{ .Port }}"
      tls_disable = 1
    }
    EOF
    chown vault:vault /etc/vault.d/vault.hcl
    chmod 640 /etc/vault.d/vault.hcl
    # Start Vault SEALED and UNINITIALIZED. Proxcloud never initialises it and
    # never sees the unseal keys or root token — the operator does that (next-steps).
    systemctl enable --now vault
