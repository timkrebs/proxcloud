# ── Proxmox connection (required) ────────────────────────────────────────────
# Base URL of the Proxmox VE API — no /api2/json suffix.
PROXMOX_URL=https://pve01.example.com:8006
# API token: create with `pveum user token add <user> <name> --privsep 0` (see README).
PROXMOX_TOKEN_ID=proxcloud@pve!portal
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# true for homelab self-signed certificates.
PROXMOX_TLS_INSECURE=false

# ── Console (optional) ───────────────────────────────────────────────────────
# Proxmox rejects API-token auth on its console websockets (vncwebsocket /
# termproxy), so the embedded noVNC/xterm console needs a real user login.
# Leave unset to run without the console feature.
#PROXMOX_CONSOLE_USER=proxcloud@pve
#PROXMOX_CONSOLE_PASSWORD=

# ── Portal auth (required) ───────────────────────────────────────────────────
# 32+ random characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
ADMIN_USER=admin
# bcrypt hash (preferred): `htpasswd -bnBC 10 "" 'yourpassword' | tr -d ':\n'`
ADMIN_PASSWORD_HASH=
# Dev-only alternative: plaintext, hashed at boot. Prefer the hash above.
#ADMIN_PASSWORD=

# ── Datastore & multi-tenancy (required) ─────────────────────────────────────
# Postgres system of record. docker-compose overrides DATABASE_URL to point at
# the bundled `postgres` service; for native `go run` the default below targets
# a local Postgres on :5432 (compose exposes one, or run your own).
DATABASE_URL=postgres://proxcloud:proxcloud@localhost:5432/proxcloud?sslmode=disable
# Encryption key for secrets at rest (TOTP secrets, later phases). Exactly
# 32 bytes, hex- or base64-encoded. Generate with: `openssl rand -hex 32`
SECRETS_KEY=
# Session lifetimes (Go durations). Idle timeout slides on activity; absolute
# timeout is the hard cap regardless of activity.
#SESSION_IDLE_TTL=12h
#SESSION_ABSOLUTE_TTL=720h
# Reconciler sweep interval (Go duration).
#RECONCILER_INTERVAL=5m
# Job scheduler & lifecycle features (ADR-0018/0019/0020). All OFF by default
# (opt-in); auto-shutdown and TTL each also require SCHEDULER_ENABLED=true.
#SCHEDULER_ENABLED=false
#AUTOSHUTDOWN_ENABLED=false
#TTL_ENABLED=false
#SCHEDULER_INTERVAL=30s
#AUTOSHUTDOWN_DEFAULT_GRACE=120s
# Credentials for the compose `postgres` service (must match DATABASE_URL).
#POSTGRES_USER=proxcloud
#POSTGRES_PASSWORD=proxcloud
#POSTGRES_DB=proxcloud
#POSTGRES_PORT=5432

# ── Pricing (optional) ───────────────────────────────────────────────────────
# Flat monthly rates for the cost estimate UI. All cost UI is hidden when unset.
#PRICING_CURRENCY=EUR
#PRICING_VCPU_MONTH=3.50
#PRICING_RAM_GB_MONTH=1.20
#PRICING_DISK_GB_MONTH=0.05

# ── Security ─────────────────────────────────────────────────────────────────
# Exact browser origin of the portal (enforced on state-changing requests
# and the console websocket). Recommended for any non-localhost deployment.
#FRONTEND_ORIGIN=https://proxcloud.example.com
# Session cookies carry Secure by default (browsers accept them on
# http://localhost). Only set this for http on a non-localhost host, dev only.
#PROXCLOUD_INSECURE_COOKIES=true
# Set to "production" to make insecure options fail at startup.
#PROXCLOUD_ENV=production

# ── Server ───────────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080
