# ── Proxmox connection (required) ────────────────────────────────────────────
# Base URL of the Proxmox VE API — no /api2/json suffix.
PROXMOX_URL=https://pve01.example.com:8006
# API token: create with `pveum user token add <user> <name> --privsep 0` (see README).
PROXMOX_TOKEN_ID=proxcloud@pve!portal
PROXMOX_TOKEN_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# true for homelab self-signed certificates.
PROXMOX_TLS_INSECURE=false

# ── Console (optional) ───────────────────────────────────────────────────────
# Proxmox rejects API-token auth on its console websockets (vncwebsocket /
# termproxy), so the embedded noVNC/xterm console needs a real user login.
# Leave unset to run without the console feature.
#PROXMOX_CONSOLE_USER=proxcloud@pve
#PROXMOX_CONSOLE_PASSWORD=

# ── Portal auth (required) ───────────────────────────────────────────────────
# 32+ random characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
ADMIN_USER=admin
# Preferred: bcrypt hash, e.g. `htpasswd -bnBC 10 "" 'yourpassword' | tr -d ':\n'`.
#ADMIN_PASSWORD_HASH=
# Dev convenience: plaintext, hashed at boot. Use the hash variant in production.
ADMIN_PASSWORD=

# ── Pricing (optional) ───────────────────────────────────────────────────────
# Flat monthly rates for the cost estimate UI. All cost UI is hidden when unset.
#PRICING_CURRENCY=EUR
#PRICING_VCPU_MONTH=3.50
#PRICING_RAM_GB_MONTH=1.20
#PRICING_DISK_GB_MONTH=0.05

# ── Server ───────────────────────────────────────────────────────────────────
LISTEN_ADDR=:8080
